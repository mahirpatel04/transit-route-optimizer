POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-password
POSTGRES_DB=your-database-name

# Used from your host machine (Postico, psql, your Go program during local dev)
DATABASE_URL=local-container-database-url

# Used by containers talking to each other inside Docker's network (e.g. the migrate service)
DATABASE_URL_COMPOSE=global-container-database-url